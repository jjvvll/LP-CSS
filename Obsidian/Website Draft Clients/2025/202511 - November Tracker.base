views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Website Draft Clients/2025/11")
    order:
      - file.name
      - Account
      - Status
      - Salesforce
      - Front End
      - Drive Folder
      - Briefing Document
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      note.Salesforce: 102
      note.Front End: 104
      note.Drive Folder: 129
